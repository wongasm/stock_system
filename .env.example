# Required Flask app settings
SECRET_KEY=replace-with-a-long-random-secret
SQLALCHEMY_DATABASE_URI=mysql://username:password@host/database_name

# Optional session settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Existing email settings
MAIL_USERNAME=binginvoice@gmail.com
MAIL_PASSWORD=replace-with-mail-app-password
MAIL_DEFAULT_SENDER=binginvoice@gmail.com

# Square access tokens and locations
DONCASTER_ACCESS_TOKEN=replace-with-square-token
DONCASTER_LOCATION_ID=replace-with-location-id
LONSDALE_ACCESS_TOKEN=replace-with-square-token
LONSDALE_LOCATION_ID=replace-with-location-id
CLAYTON_ACCESS_TOKEN=replace-with-square-token
CLAYTON_LOCATION_ID=replace-with-location-id
GLEN_WAVERLEY_ACCESS_TOKEN=replace-with-square-token
GLEN_WAVERLEY_LOCATION_ID=replace-with-location-id
